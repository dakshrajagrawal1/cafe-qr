{
  "name": "cafe-qr-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant SaaS cafe QR table ordering platform",
  "scripts": {
    "dev": "pnpm --filter @cafe-qr/server dev",
    "dev:all": "pnpm --parallel --filter @cafe-qr/server --filter @cafe-qr/customer --filter @cafe-qr/staff dev",
    "dev:server": "pnpm --filter @cafe-qr/server dev",
    "dev:customer": "pnpm --filter @cafe-qr/customer dev",
    "dev:staff": "pnpm --filter @cafe-qr/staff dev",
    "docker:db": "docker compose up -d",
    "db:setup": "pnpm --filter @cafe-qr/server db:push && pnpm --filter @cafe-qr/server db:seed",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @cafe-qr/server db:generate",
    "db:migrate": "pnpm --filter @cafe-qr/server db:migrate",
    "db:seed": "pnpm --filter @cafe-qr/server db:seed",
    "db:push": "pnpm --filter @cafe-qr/server db:push",
    "test": "pnpm --filter @cafe-qr/server test",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}